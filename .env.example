# ============================================================
# Greenlife Daily — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- SMTP (Nodemailer) — domain mailbox example ----
# Use SMTP details from your email/hosting provider for info@greenlifedaily.co.za
SMTP_HOST=mail.greenlifedaily.co.za
SMTP_PORT=587
SMTP_USER=info@greenlifedaily.co.za
SMTP_PASS=
SMTP_FROM=Greenlife Daily <info@greenlifedaily.co.za>

# Quote form notifications are delivered here
GREENLIFE_EMAIL=info@greenlifedaily.co.za

# ---- WhatsApp ----
# WhatsApp number in international format without + (e.g. 27823302132)
NEXT_PUBLIC_WHATSAPP_NUMBER=27823302132

# ---- Phone ----
# South African phone number for click-to-call (e.g. 082 330 2132)
NEXT_PUBLIC_PHONE_NUMBER=082 330 2132

# ---- Google Maps ----
# Optional override for the contact page map embed.
# Leave empty to use the default embed for 87 Tennyson Road, Lombardy East, 2090.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://maps.google.com/maps?q=87+Tennyson+Road,+Lombardy+East,+2090&z=16&hl=en&output=embed
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# ---- reCAPTCHA v3 (optional — leave empty to disable) ----
# Secret key (server-side only — never expose publicly)
RECAPTCHA_SECRET_KEY=

# Site key (client-side — safe to expose, hence NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
